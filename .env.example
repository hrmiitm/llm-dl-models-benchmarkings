# Direct OpenRouter (preferred). Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional: access OpenRouter through LLM Foundry instead.
# --provider auto uses OpenRouter if its key is set, otherwise Foundry.
LLMFOUNDRY_BASE_URL=https://llmfoundry.straivedemo.com
LLMFOUNDRY_API_KEY=
